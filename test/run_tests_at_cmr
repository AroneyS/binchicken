#!/usr/bin/env python3

import glob
import os
import subprocess
import sys
import tempfile
import time
import extern

# To invoke this script:
# $ pixi run run-tests-at-cmr
#
# To resume a run that was interrupted (e.g. by cluster maintenance) without
# discarding the output already produced:
# $ pixi run run-tests-at-cmr-resume

# Passed through to pytest so that tests keep, rather than delete, their existing
# output directories. Only safe when binchicken itself has not changed since the
# interrupted run: snakemake is invoked with --rerun-triggers mtime and so will not
# rerun completed rules just because the code changed.
RESUME = "--resume" in sys.argv[1:]
resume_arg = " --resume" if RESUME else ""

def collect_tests(marker):
    """Collect all test nodeids marked with the given pytest marker."""
    # Unfortunately, pytest.main doesn't return nodeids directly.
    # Instead, we'll use subprocess to parse the output.
    result = subprocess.run(
        ['pytest', '--collect-only', '-q', '-m', marker, 'test'],
        capture_output=True, text=True
    )
    nodeids = [
        line.strip() for line in result.stdout.splitlines()
        if line.strip() and line.strip().startswith('test/') and not line.endswith('<module>')
    ]
    return nodeids

MQSUB_OUT="mqsub.out"
# Remove old mqsub output file
if os.path.exists(MQSUB_OUT):
    os.remove(MQSUB_OUT)

# Expensive tests
expensive_tests = collect_tests('expensive')
print(f"Running {len(expensive_tests)} expensive tests individually via mqsub{' (resuming)' if RESUME else ''}..")
if not expensive_tests:
    raise ValueError("No tests marked as 'expensive' found.")
for test in expensive_tests:
    print(f"mqsub Expensive test: {test} ..")
    cmd = (
        "mqsub -t 16 -m 128 --hours 4 --segregated-log-files --bg -- "
        f"pixi run -e dev pytest --run-expensive{resume_arg} {test} &>>{MQSUB_OUT}"
    )
    extern.run(cmd)

# qsub tests run locally because they qsub themselves (via snakemake's aqua profile).
# Each blocks until its whole workflow finishes, so give each its own pytest process
# and run them concurrently rather than queueing one behind another's cluster jobs.
qsub_tests = collect_tests('qsub')
print(f"Running {len(qsub_tests)} qsub tests concurrently, each of which qsubs itself{' (resuming)' if RESUME else ''}..")
if not qsub_tests:
    raise ValueError("No tests marked as 'qsub' found.")
# Remove logs from previous runs so stale results aren't mistaken for this run's
for old_log in glob.glob("test/qsub-test-log*.txt"):
    os.remove(old_log)
qsub_processes = {}
for test in qsub_tests:
    log_path = f"test/qsub-test-log.{test.split('::')[-1]}.txt"
    print(f"Local qsub test: {test} (log: {log_path}) ..")
    with open(log_path, "w") as log_file:
        # The child inherits its own handle on the log file, so this one can be closed
        qsub_processes[test] = (
            subprocess.Popen(
                [
                    "pixi", "run", "-e", "dev",
                    "pytest", "--run-qsub",
                ] + (["--resume"] if RESUME else []) + [test],
                stdout=log_file,
                stderr=subprocess.STDOUT,
            ),
            log_path,
        )

fails = 0
pending = dict(qsub_processes)
while pending:
    time.sleep(60)
    for test, (process, log_path) in list(pending.items()):
        if process.poll() is None:
            continue
        del pending[test]
        if process.returncode != 0:
            fails += 1
            print(f"Error: qsub test {test} failed with return code {process.returncode}. See {log_path} for details.")
        else:
            print(f"qsub test {test} passed. See {log_path} for details.")
print(f"{len(qsub_tests) - fails} of {len(qsub_tests)} qsub tests passed.\n")

with open(MQSUB_OUT, "r") as mqsub_file:
    mqsub_lines = mqsub_file.readlines()
    # e.g.
    # 06/30/2025 05:19:34 PM INFO: Creating segregated log directory /mnt/hpccs01/home/woodcrob/qsub_logs/2025-06-30/pixi-2
    # 06/30/2025 05:19:34 PM INFO: qsub stdout was: 6687439.aqua
    # qsub stdout: 6687439.aqua

    # 06/30/2025 05:19:34 PM INFO: Creating segregated log directory /mnt/hpccs01/home/woodcrob/qsub_logs/2025-06-30/pixi-3
    # 06/30/2025 05:19:34 PM INFO: qsub stdout was: 6687440.aqua
    # qsub stdout: 6687440.aqua
    job_ids = [
        line.split("qsub stdout: ")[1].strip() for line in mqsub_lines
        if line.startswith("qsub stdout: ")
    ]
    print(f"Found {len(job_ids)} job IDs e.g. {job_ids[0]}, running mqwait for them..")
    with tempfile.NamedTemporaryFile() as temp_file:
        temp_file.write("\n".join(job_ids).encode())
        temp_file.flush()
        subprocess.run(["mqwait", "-i", temp_file.name], check=True)

    segregated_log_dirs = [
        line.split("Creating segregated log directory ")[1].strip()
        for line in mqsub_lines
        if "Creating segregated log directory " in line
    ]
    print(f"Found {len(segregated_log_dirs)} segregated log directories, e.g. {segregated_log_dirs[0]}")

    if len(segregated_log_dirs) != len(job_ids):
        raise ValueError("Warning: Number of segregated log directories does not match number of job IDs. job_ids: {}".format(job_ids))

    job_id_to_output = {}
    job_id_to_path = {}
    for (job_id, log_dir) in zip(job_ids, segregated_log_dirs):
        # Check if the log directory exists
        if not os.path.exists(log_dir):
            print(f"Warning: Log directory {log_dir} for job {job_id} does not exist.")
        else:
            job_path = os.path.join(log_dir, f"{job_id}.OU")
            job_id_to_path[job_id] = job_path
            with open(job_path) as stdout_file:
                job_id_to_output[job_id] = stdout_file.read()

    # For each job, report if any line starts with FAILED
    for job_id, output in job_id_to_output.items():
        if any(line.startswith("FAILED") for line in output.splitlines()):
            fails += 1
            print(f"Job {job_id} has FAILED lines in its output. See {job_id_to_path[job_id]} for details.")
            print(output)
    if fails > 0:
        print(f"Total number of jobs with FAILED lines: {fails}")
        sys.exit(fails)
    else:
        print("All jobs completed successfully without FAILED lines in their output. Win.")
        sys.exit(0)
